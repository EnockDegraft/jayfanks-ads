# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Required by the backend. Supabase: project → Connect → "Transaction pooler" (port 6543).
# Don't use the direct "db.<project-ref>.supabase.co" address: it's IPv6-only and fails on most
# networks and on Vercel. Replace [YOUR-PASSWORD], URL-encoded if it has symbols like @ : / ? #
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-<n>-<region>.pooler.supabase.com:6543/postgres

# Optional, not used by the backend. Only for public, non-personal data in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
